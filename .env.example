# You need Google Recaptcha token for below field and you should add *localhost* domain in Google Recaptcha console "Domains" section
# https://www.google.com/recaptcha/admin/create
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional Cloudflare Worker proxy tried first in getUserId(); falls through to other methods if unset or failing
INSTAGRAM_WORKER_URL=
